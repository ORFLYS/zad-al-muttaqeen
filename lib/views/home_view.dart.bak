                                      );
                                    },
                                    cardWidth: cardWidth,
                                  ),
                                  _buildIndividualGridCard(
                                    icon: Icons.assignment_outlined,
                                    title: "الأعمال",
                                    onTap: () {
                                      final todayEvents = ShiaData.events.where((e) => e.day == hijriDate.hDay && e.month == hijriDate.hMonth).toList();
                                      if (todayEvents.isNotEmpty) {
                                        _showEventsBottomSheet(context, todayEvents, showAll: false);
                                      } else {
                                        _showEventsBottomSheet(context, ShiaData.events, showAll: true);
                                      }
                                    },
                                    cardWidth: cardWidth,
                                  ),
                                  _buildIndividualGridCard(
                                    icon: Icons.calendar_month_outlined, // التقويم الهجري المحدث بصرياً
                                    title: "التقويم الهجري",
                                    onTap: () {
                                      _showHijriCalendarBottomSheet(context, provider);
                                    },
                                    cardWidth: cardWidth,
                                  ),
                                  _buildIndividualGridCard(
                                    icon: Icons.grid_view_outlined, // الخدمات
                                    title: "الخدمات",
                                    onTap: () => _showServicesBottomSheet(context),
                                    cardWidth: cardWidth,
                                  ),
                                ],
                              ),
                            ],
                          ),
                        ),
                        const SizedBox(height: 16),
                      ],
                    ),
                  ),
                ),

                // 5. البانر الإعلاني الدائري الفاخر لزيارة عاشوراء (مستقر بالأسفل تماماً فوق شريط القائمة السفلي)
                GestureDetector(
                  onTap: () {
                    Navigator.of(context).push(
                      MaterialPageRoute(
                        builder: (context) => ReaderScreen(
                          title: _sliderItems[_activeSliderIndex]["title"]!,
                          text: _sliderItems[_activeSliderIndex]["text"]!,
                          benefits: _sliderItems[_activeSliderIndex]["desc"]!,
                        ),
                      ),
                    );
                  },
                  child: _buildThinGlassCard(
                    margin: const EdgeInsets.only(left: 16, right: 16, bottom: 84, top: 8), // bottom margin 84 to float perfectly above the 72px nav bar!
                    padding: const EdgeInsets.all(14),
                    borderRadius: 20,
                    opacity: 0.35, // زجاج شفاف فخم يتناسب مع الكروت الباقية
                    child: Row(
                      children: [
                        // زر السهم اليساري الشفاف الفاخر للتنقل اليدوي
                        GestureDetector(
                          onTap: () {
                            _sliderTick = 0;
                            _slideNext();
                          },
                          child: Container(
                            width: 32,
                            height: 32,
                            decoration: BoxDecoration(
                              shape: BoxShape.circle,
                              color: Colors.white.withValues(alpha: 0.1),
                            ),
                            child: const Icon(Icons.arrow_back_ios_new, size: 12, color: Colors.white),
                          ),
                        ),
                        const SizedBox(width: 14),

                        // تفاصيل الزيارة والوصف والـ Dots
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                _sliderItems[_activeSliderIndex]["title"]!,
                                style: GoogleFonts.cairo(
                                  fontSize: 13.5,
                                  fontWeight: FontWeight.w900,
                                  color: Colors.white,
                                ),
                              ),
                              const SizedBox(height: 2),
                              Text(
                                _sliderItems[_activeSliderIndex]["desc"]!,
                                style: GoogleFonts.cairo(
                                  fontSize: 10.5,
                                  fontWeight: FontWeight.bold,
                                  color: Colors.white70,
                                ),
                              ),
                              const SizedBox(height: 8),

                              // مؤشرات الصفحات الـ 3 الصغيرة
                              Row(
                                children: [
                                  _buildSlideDot(_activeSliderIndex == 0),
                                  const SizedBox(width: 4),
                                  _buildSlideDot(_activeSliderIndex == 1),
                                  const SizedBox(width: 4),
                                  _buildSlideDot(_activeSliderIndex == 2),
                                ],
                              ),
                            ],
                          ),
                        ),

                        // الصورة الدائرية الشريفة المقصوصة (Circular Masked Dome Asset)
                        Container(
                          width: 58,
                          height: 58,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            border: Border.all(color: const Color(0xFFC5A880), width: 1.0),
                            image: const DecorationImage(
                              image: AssetImage("assets/background.jpg"),
                              fit: BoxFit.cover,
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  /// بناء كارت منفرد مخصص للشبكة الثمانية الموحدة (Frosted Glass Individual Grid Item)
  Widget _buildIndividualGridCard({
    required IconData icon,
    required String title,
    required VoidCallback onTap,
    required double cardWidth,
  }) {
    return _buildThinGlassCard(
      margin: EdgeInsets.zero,
      padding: EdgeInsets.zero,
      borderRadius: 16,
      opacity: 0.32, // زجاج شفاف ممتاز ومطابق تماماً للصورة المرجعية
      child: SizedBox(
        width: cardWidth,
        height: 76,
        child: Material(
          color: Colors.transparent,
          child: InkWell(
            onTap: onTap,
            borderRadius: BorderRadius.circular(16),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(
                  icon,
                  color: Colors.white,
                  size: 24,
                ),
                const SizedBox(height: 5),
                Text(
                  title,
                  style: GoogleFonts.cairo(
                    fontSize: 10.5,
                    fontWeight: FontWeight.w900,
                    color: Colors.white,
                  ),
                  textAlign: TextAlign.center,
                  maxLines: 1,
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  /// بناء عنصر وقت الصلاة الرفيع الصغير في الكارت الأفقي
  Widget _buildMinimalPrayerItem(String name, DateTime time, String activePrayer, IconData icon) {
    final format = intl.DateFormat('hh:mm').format(time);
    bool isActive = (name == activePrayer);

    return Column(
      children: [
        Text(
          name,
          style: GoogleFonts.cairo(
            fontSize: 9,
            fontWeight: FontWeight.bold,
            color: isActive ? const Color(0xFFE5C158) : Colors.white70,
          ),
        ),
        const SizedBox(height: 4),
        Icon(
          icon,
          size: 13,
          color: isActive ? const Color(0xFFE5C158) : Colors.white70,
        ),
        const SizedBox(height: 4),
        Text(
          format,
          style: GoogleFonts.orbitron(
            fontSize: 9.5,
            fontWeight: FontWeight.w800,
            color: isActive ? const Color(0xFFE5C158) : Colors.white,
          ),
        ),
      ],
    );
  }

  void _showCityPickerDialog(BuildContext context, AppProvider provider) {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (BuildContext context) {
        return _ShiaLocationBottomSheet(provider: provider);
      },
    );
  }


  Widget _buildSlideDot(bool active) {
    return Container(
      width: active ? 12 : 5,
      height: 5,
      decoration: BoxDecoration(
        color: active ? const Color(0xFFE5C158) : Colors.white30,
        borderRadius: BorderRadius.circular(2.5),
      ),
    );
  }

  /// منبثق سفلي يعرض أوراد الأذكار الجعفرية اليومية وتعقيبات الصلاة
  void _showAzkarBottomSheet(BuildContext context) {
    // قائمة أذكار أيام الأسبوع الجعفرية
    final List<Map<String, String>> weekAzkar = [
      {"day": "السبت", "dhikr": "يَا رَبَّ الْعَالَمِين", "count": "100 مرة", "reward": "توجب استجابة الدعاء وقضاء الحوائج"},
      {"day": "الأحد", "dhikr": "يَا ذَا الْجَلَالِ وَالْإِكْرَام", "count": "100 مرة", "reward": "تزيد في الإيمان وتيسر الأمور"},
      {"day": "الإثنين", "dhikr": "يَا قَاضِيَ الْحَاجَات", "count": "100 مرة", "reward": "توجب نيل المقامات والبركة في الرزق"},
      {"day": "الثلاثاء", "dhikr": "يَا أَرْحَمَ الرَّاحِمِين", "count": "100 مرة", "reward": "تفتح أبواب الرحمة وتدفع البلاء"},
      {"day": "الأربعاء", "dhikr": "يَا حَيُّ يَا قَيُّوم", "count": "100 مرة", "reward": "تزيد في العمر وصلاح المعاش والآخرة"},
      {"day": "الخميس", "dhikr": "لَا إِلٰهَ إِلَّا اللهُ الْمَلِكُ الْحَقُّ الْمُبِين", "count": "100 مرة", "reward": "توجب الغنى وطرد الفقر وحفظ القبر"},
      {"day": "الجمعة", "dhikr": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ وَعَجِّلْ فَرَجَهُم", "count": "100 مرة", "reward": "تمحو السيئات وترفع الدرجات العظمى"},
    ];

    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.white,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (context) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: DraggableScrollableSheet(
            initialChildSize: 0.6,
            minChildSize: 0.4,
            maxChildSize: 0.85,
            expand: false,
            builder: (context, scrollController) {
              return Padding(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  children: [
                    Container(
                      width: 40,
                      height: 4,
                      margin: const EdgeInsets.only(bottom: 12),
                      decoration: BoxDecoration(
                        color: Colors.grey[300],
                        borderRadius: BorderRadius.circular(2),
                      ),
                    ),
                    Text(
                      "الأذكار اليومية المستحبة لأيام الأسبوع",
                      style: GoogleFonts.cairo(
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                        color: const Color(0xFF8A1525),
                      ),
                    ),
                    const Divider(height: 20, color: Color(0xFFF1F5F9)),
                    
                    Expanded(
                      child: ListView.builder(
                        controller: scrollController,
                        itemCount: weekAzkar.length,
                        itemBuilder: (context, index) {
                          final item = weekAzkar[index];
                          // معرفة اليوم الحالي لتسليط الضوء عليه
                          final weekday = DateTime.now().weekday;
                          bool isToday = false;
                          if (item["day"] == "السبت" && weekday == DateTime.saturday) isToday = true;
                          if (item["day"] == "الأحد" && weekday == DateTime.sunday) isToday = true;
                          if (item["day"] == "الإثنين" && weekday == DateTime.monday) isToday = true;
                          if (item["day"] == "الثلاثاء" && weekday == DateTime.tuesday) isToday = true;
                          if (item["day"] == "الأربعاء" && weekday == DateTime.wednesday) isToday = true;
                          if (item["day"] == "الخميس" && weekday == DateTime.thursday) isToday = true;
                          if (item["day"] == "الجمعة" && weekday == DateTime.friday) isToday = true;

                          return GestureDetector(
                            onTap: () {
                              Navigator.of(context).push(
                                MaterialPageRoute(
                                  builder: (context) => ReaderScreen(
                                    title: "أذكار يوم ${item["day"]}",
                                    text: "${item["dhikr"]}\n\n( ${item["count"]} )",
                                    benefits: item["reward"]!,
                                  ),
                                ),
                              );
                            },
                            child: Container(
                              margin: const EdgeInsets.only(bottom: 12),
                              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                              decoration: BoxDecoration(
                                color: isToday ? const Color(0xFFFAF5EC) : Colors.white,
                                borderRadius: BorderRadius.circular(16),
                                boxShadow: [
                                  BoxShadow(
                                    color: isToday 
                                        ? const Color(0xFF8A1525).withValues(alpha: 0.06)
                                        : Colors.black.withValues(alpha: 0.015),
                                    blurRadius: 12,
                                    offset: const Offset(0, 4),
                                  )
                                ],
                                border: Border.all(
                                  color: isToday ? const Color(0xFF8A1525) : const Color(0xFFE2E8F0),
                                  width: isToday ? 1.6 : 1.0,
                                ),
                              ),
                              child: Row(
                                children: [
                                  // 1. شارة اليوم الأنيقة (اليمين)
                                  Container(
                                    width: 68,
                                    height: 34,
                                    alignment: Alignment.center,
                                    decoration: BoxDecoration(
                                      color: isToday ? const Color(0xFF8A1525) : const Color(0xFFFAF5EC),
                                      borderRadius: BorderRadius.circular(8),
                                      border: Border.all(
                                        color: isToday ? const Color(0xFF8A1525) : const Color(0xFFC5A880).withValues(alpha: 0.2),
                                        width: 1.0,
                                      ),
                                    ),
                                    child: Text(
                                      item["day"]!,
                                      style: GoogleFonts.cairo(
                                        fontSize: 12,
                                        fontWeight: FontWeight.w900,
                                        color: isToday ? Colors.white : const Color(0xFFC5A880),
                                      ),
                                    ),
                                  ),
                                  const SizedBox(width: 14),
                                  
                                  // 2. خط فاصل عمودي ناعم وفخم
                                  Container(
                                    width: 1.0,
                                    height: 36,
                                    color: isToday ? const Color(0xFF8A1525).withValues(alpha: 0.15) : const Color(0xFFE2E8F0),
                                  ),
                                  const SizedBox(width: 14),

                                  // 3. الذكر وتفاصيله (المنتصف)
                                  Expanded(
                                    child: Column(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        Text(
                                          item["dhikr"]!,
                                          style: GoogleFonts.amiri(
                                            fontSize: 18,
                                            fontWeight: FontWeight.bold,
                                            height: 1.3,
                                            color: isToday ? const Color(0xFF8A1525) : const Color(0xFF1E293B),
                                          ),
                                        ),
                                        const SizedBox(height: 4),
                                        Row(
                                          children: [
                                            // شارة العدد الصغير بلون ذهبي/ماروني ناعم
                                            Container(
                                              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                                              decoration: BoxDecoration(
                                                color: isToday ? const Color(0xFF8A1525).withValues(alpha: 0.08) : const Color(0xFFF1F5F9),
                                                borderRadius: BorderRadius.circular(4),
                                              ),
                                              child: Text(
                                                item["count"]!,
                                                style: GoogleFonts.cairo(
                                                  fontSize: 9,
                                                  fontWeight: FontWeight.w900,
                                                  color: isToday ? const Color(0xFF8A1525) : const Color(0xFF64748B),
                                                ),
                                              ),
                                            ),
                                            const SizedBox(width: 8),
                                            // وصف الأجر
                                            Expanded(
                                              child: Text(
                                                item["reward"]!,
                                                style: GoogleFonts.cairo(
                                                  fontSize: 10.5,
                                                  fontWeight: FontWeight.bold,
                                                  color: const Color(0xFF64748B),
                                                ),
                                                maxLines: 1,
                                                overflow: TextOverflow.ellipsis,
                                              ),
                                            ),
                                          ],
                                        ),
                                      ],
                                    ),
                                  ),

                                  // 4. أيقونة نجمة اليوم الفائقة الجودة (اليسار)
                                  if (isToday) ...[
                                    const SizedBox(width: 8),
                                    Container(
                                      padding: const EdgeInsets.all(5),
                                      decoration: const BoxDecoration(
                                        shape: BoxShape.circle,
                                        color: Color(0xFF8A1525),
                                      ),
                                      child: const Icon(Icons.star, color: Color(0xFFC5A880), size: 12),
                                    ),
                                  ],
                                ],
                              ),
                            ),
                          );
                        },
                      ),
                    ),
                  ],
                ),
              );
            },
          ),
        );
      },
    );
  }

  /// منبثق سفلي فاخر لعرض قائمة الخدمات الإسلامية المتنوعة
  void _showServicesBottomSheet(BuildContext context) {
    final provider = Provider.of<AppProvider>(context, listen: false);
    
    // قائمة الخدمات المتنوعة
    final List<Map<String, dynamic>> services = [
      {
        "icon": Icons.explore_outlined,
        "title": "بوصلة القبلة",
        "desc": "تحديد اتجاه القبلة بدقة عالية",
        "action": () {
          Navigator.of(context).pop();
          Navigator.of(context).push(
            MaterialPageRoute(builder: (context) => const QiblaView()),
          );
        },
      },
      {
        "icon": Icons.adjust_outlined,
        "title": "المسبحة",
        "desc": "تسبيح الزهراء (ع) والأذكار",
        "action": () {
          Navigator.of(context).pop();
          provider.setActiveTab(3);
        },
      },
      {
        "icon": Icons.format_list_numbered_rtl,
        "title": "عدد الركعات",
        "desc": "ركعات الصلوات اليومية والنوافل",
        "action": () {
          Navigator.of(context).pop();
          _showRakaatBottomSheet(context);
        },
      },
      {
        "icon": Icons.calendar_month_outlined,
        "title": "التقويم الهجري",
        "desc": "مناسبات وأعياد أهل البيت (ع)",
        "action": () {
          Navigator.of(context).pop();
          final allEvents = ShiaData.events;
          _showEventsBottomSheet(context, allEvents, showAll: true);
        },
      },
      {
        "icon": Icons.music_note_outlined,
        "title": "النغمات",
        "desc": "أصوات أذان وأدعية للهاتف",
        "action": () {
          Navigator.of(context).pop();
          _showRingtonesBottomSheet(context);
        },
      },
      {
        "icon": Icons.star_outline_rounded,
        "title": "أسماء الله الحسنى",
        "desc": "99 اسماً من أسماء الله تعالى",
        "action": () {
          Navigator.of(context).pop();
          _showAsmaaAllahBottomSheet(context);
        },
      },
      {
        "icon": Icons.share_outlined,
        "title": "مشاركة التطبيق",
        "desc": "شارك الخير مع أحبائك",
        "action": () {
          Navigator.of(context).pop();
          // يمكن إضافة منطق المشاركة لاحقاً
        },
      },
      {
        "icon": Icons.info_outline_rounded,
        "title": "عن التطبيق",
        "desc": "معلومات الإصدار والمطور",
        "action": () {
          Navigator.of(context).pop();
          _showAboutAppDialog(context);
        },
      },
    ];
    
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.white,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (context) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: Padding(
            padding: const EdgeInsets.fromLTRB(16, 12, 16, 24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                // مقبض السحب العلوي
                Container(
                  width: 40,
                  height: 4,
                  margin: const EdgeInsets.only(bottom: 16),
                  decoration: BoxDecoration(
                    color: Colors.grey[300],
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
                // عنوان القائمة
                Text(
                  "الخدمات",
                  style: GoogleFonts.cairo(
                    fontSize: 18,
                    fontWeight: FontWeight.w900,
                    color: const Color(0xFF8A1525),
                  ),
                ),
                const SizedBox(height: 16),
                // شبكة الخدمات (4 أعمدة × 2 صفوف)
                GridView.builder(
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 4,
                    mainAxisSpacing: 12,
                    crossAxisSpacing: 8,
                    childAspectRatio: 0.75,
                  ),
                  itemCount: services.length,
                  itemBuilder: (context, index) {
                    final item = services[index];
                    return GestureDetector(
                      onTap: item["action"] as VoidCallback,
                      child: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Container(
                            width: 52,
                            height: 52,
                            decoration: BoxDecoration(
                              color: const Color(0xFF8A1525).withValues(alpha: 0.08),
                              borderRadius: BorderRadius.circular(16),
                            ),
                            child: Icon(
                              item["icon"] as IconData,
                              size: 26,
                              color: const Color(0xFF8A1525),
                            ),
                          ),
                          const SizedBox(height: 6),
                          Text(
                            item["title"] as String,
                            textAlign: TextAlign.center,
                            style: GoogleFonts.cairo(
                              fontSize: 10.5,
                              fontWeight: FontWeight.w800,
                              color: const Color(0xFF1E293B),
                            ),
                            maxLines: 1,
                            overflow: TextOverflow.ellipsis,
                          ),
                          Text(
                            item["desc"] as String,
                            textAlign: TextAlign.center,
                            style: GoogleFonts.cairo(
                              fontSize: 8,
                              fontWeight: FontWeight.w600,
                              color: Colors.grey[500],
                            ),
                            maxLines: 1,
                            overflow: TextOverflow.ellipsis,
                          ),
                        ],
                      ),
                    );
                  },
                ),
                const SizedBox(height: 8),
              ],
            ),
          ),
        );
      },
    );
  }

  /// منبثق عدد ركعات الصلوات اليومية والنوافل حسب المذهب الجعفري
  void _showRakaatBottomSheet(BuildContext context) {
    final List<Map<String, String>> rakaatData = [
      {"name": "صلاة الصبح", "fard": "٢", "nafila": "٢", "total": "٤"},
      {"name": "صلاة الظهر", "fard": "٤", "nafila": "٨", "total": "١٢"},
      {"name": "صلاة العصر", "fard": "٤", "nafila": "٨", "total": "١٢"},
      {"name": "صلاة المغرب", "fard": "٣", "nafila": "٤", "total": "٧"},
      {"name": "صلاة العشاء", "fard": "٤", "nafila": "٢", "total": "٦"},
      {"name": "صلاة الليل", "fard": "-", "nafila": "١١", "total": "١١"},
    ];
    
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (context) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  width: 40, height: 4,
                  margin: const EdgeInsets.only(bottom: 12),
                  decoration: BoxDecoration(color: Colors.grey[300], borderRadius: BorderRadius.circular(2)),
                ),
