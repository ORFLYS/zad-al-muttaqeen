      },
    );
  }
}

// نافذة تفاعلية من مستويين تظهر من الأسفل لاختيار الدولة أولاً ثم المدينة/المحافظة المقابلة لها
class _ShiaLocationBottomSheet extends StatefulWidget {
  final AppProvider provider;

  const _ShiaLocationBottomSheet({required this.provider});

  @override
  State<_ShiaLocationBottomSheet> createState() => _ShiaLocationBottomSheetState();
}

class _ShiaLocationBottomSheetState extends State<_ShiaLocationBottomSheet> {
  ShiaCountry? _selectedCountry;

  @override
  Widget build(BuildContext context) {
    final titleText = _selectedCountry == null
        ? "اختر الدولة للحساب الشرعي"
        : "اختر المدينة في ${_selectedCountry!.name}";

    return Directionality(
      textDirection: TextDirection.rtl,
      child: Container(
        height: MediaQuery.of(context).size.height * 0.65,
        decoration: const BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.vertical(
            top: Radius.circular(24),
          ),
        ),
        child: Column(
          children: [
            // مقبض سحب علوي أنيق للتصميم العصري
            const SizedBox(height: 12),
            Container(
              width: 50,
              height: 5,
              decoration: BoxDecoration(
                color: const Color(0xFFE2E8F0),
                borderRadius: BorderRadius.circular(10),
              ),
            ),
            const SizedBox(height: 16),
            
            // شريط رأس المنبثق
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 20),
              child: Row(
                children: [
                  if (_selectedCountry != null)
                    IconButton(
                      icon: const Icon(Icons.arrow_forward, color: Color(0xFF0F172A), size: 24),
                      onPressed: () {
                        setState(() {
                          _selectedCountry = null;
                        });
                      },
                      constraints: const BoxConstraints(),
                      padding: const EdgeInsets.only(left: 12),
                    ),
                  Expanded(
                    child: Text(
                      titleText,
                      style: GoogleFonts.cairo(
                        fontWeight: FontWeight.bold,
                        fontSize: 17, // تكبير خط العنوان للوضوح
                        color: const Color(0xFF0F172A),
                      ),
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 12),
            const Divider(height: 1, color: Color(0xFFE2E8F0)),
            
            // محتوى القائمة
            Expanded(
              child: _selectedCountry == null ? _buildCountryList() : _buildCityList(),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildCountryList() {
    return ListView.separated(
      shrinkWrap: true,
      physics: const BouncingScrollPhysics(),
      itemCount: LocationService.countries.length,
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      separatorBuilder: (context, index) => const Divider(height: 1, color: Color(0xFFF1F5F9)),
      itemBuilder: (context, index) {
        final country = LocationService.countries[index];
        
        // التحقق مما إذا كانت المدينة الحالية تنتمي لهذه الدولة لنضيف شارة تميز الحالية
        final bool isCurrentCountry = country.cities.any(
          (c) => c.name == widget.provider.selectedCity.name && !widget.provider.isGpsActive
        );

        return ListTile(
          contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8), // زيادة المساحة للوضوح
          title: Text(
            country.name,
            style: GoogleFonts.cairo(
              fontSize: 16.5, // خط كبير وواضح جداً
              fontWeight: isCurrentCountry ? FontWeight.bold : FontWeight.w700, // سماكة واضحة
              color: isCurrentCountry ? const Color(0xFF8A1525) : const Color(0xFF0F172A), // تباين قوي
            ),
          ),
          trailing: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              if (isCurrentCountry)
                Container(
                  margin: const EdgeInsets.only(left: 12),
                  padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                  decoration: BoxDecoration(
                    color: const Color(0xFFFEE2E2),
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Text(
                    "الحالية",
                    style: GoogleFonts.cairo(
                      fontSize: 11, // خط الشارة واضح ومقروء
                      fontWeight: FontWeight.bold,
                      color: const Color(0xFF8A1525),
                    ),
                  ),
                ),
              const Icon(Icons.chevron_left, color: Color(0xFF475569), size: 22),
            ],
          ),
          onTap: () {
            setState(() {
              _selectedCountry = country;
            });
          },
        );
      },
    );
  }

  Widget _buildCityList() {
    final cities = _selectedCountry!.cities;
    return ListView.separated(
      shrinkWrap: true,
      physics: const BouncingScrollPhysics(),
      itemCount: cities.length,
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      separatorBuilder: (context, index) => const Divider(height: 1, color: Color(0xFFF1F5F9)),
      itemBuilder: (context, index) {
        final city = cities[index];
        final isSelected = widget.provider.selectedCity.name == city.name && !widget.provider.isGpsActive;
        
        return ListTile(
          contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8), // زيادة الهوامش للوضوح
          title: Text(
            city.name.split('،').first, // اسم المدينة فقط للاختصار الأنيق
            style: GoogleFonts.cairo(
              fontSize: 16.5, // خط كبير وواضح جداً
              fontWeight: isSelected ? FontWeight.bold : FontWeight.w700, // سماكة واضحة
              color: isSelected ? const Color(0xFF8A1525) : const Color(0xFF0F172A), // تباين قوي
            ),
          ),
          subtitle: Text(
            "شرقاً: ${city.longitude.toStringAsFixed(2)}° | شمالاً: ${city.latitude.toStringAsFixed(2)}°",
            style: GoogleFonts.cairo(
              fontSize: 11,
              fontWeight: FontWeight.w600,
              color: const Color(0xFF64748B),
            ),
          ),
          trailing: isSelected 
              ? const Icon(Icons.check_circle, color: Color(0xFF8A1525), size: 24) 
              : null,
          onTap: () {
            // البحث عن الفهرس العام للمدينة لتخزينها بدقة ومطابقة البنية السابقة
            final globalIndex = LocationService.shiaCities.indexWhere(
              (c) => c.name == city.name
            );
            widget.provider.selectCity(city, globalIndex);
            Navigator.of(context).pop();
          },
        );
      },
    );
  }
}

// ==========================================
// التقويم الهجري الشهري التفاعلي الجديد
// ==========================================
class _HijriCalendarDialog extends StatefulWidget {
  final AppProvider provider;

  const _HijriCalendarDialog({required this.provider});

  @override
  State<_HijriCalendarDialog> createState() => _HijriCalendarDialogState();
}

class _HijriCalendarDialogState extends State<_HijriCalendarDialog> {
  late int currentYear;
  late int currentMonth;
  late int selectedDay;
  late HijriCalendar todayHijri;

  @override
  void initState() {
    super.initState();
    todayHijri = HijriCalendar.fromDate(DateTime.now().add(Duration(days: widget.provider.hijriOffset)));
    currentYear = todayHijri.hYear;
    currentMonth = todayHijri.hMonth;
    selectedDay = todayHijri.hDay;
  }

  void _changeMonth(int direction) {
    setState(() {
      currentMonth += direction;
      if (currentMonth > 12) {
        currentMonth = 1;
        currentYear++;
      } else if (currentMonth < 1) {
        currentMonth = 12;
        currentYear--;
      }
      selectedDay = 1;
    });
  }

  int _getWeekdayOffset(int weekday) {
    switch (weekday) {
      case DateTime.saturday: return 0;
      case DateTime.sunday: return 1;
      case DateTime.monday: return 2;
      case DateTime.tuesday: return 3;
      case DateTime.wednesday: return 4;
      case DateTime.thursday: return 5;
      case DateTime.friday: return 6;
      default: return 0;
    }
  }

  @override
  Widget build(BuildContext context) {
    const hijriMonths = [
      'محرّم', 'صفر', 'ربيع الأول', 'ربيع الثاني', 'جمادى الأولى', 'جمادى الآخرة',
      'رجب', 'شعبان', 'رمضان', 'شوّال', 'ذو القعدة', 'ذو الحجّة'
    ];
    
    final tempCal = HijriCalendar();
    final totalDays = tempCal.getDaysInMonth(currentYear, currentMonth);
    DateTime firstDayG;
    try {
      firstDayG = tempCal.hijriToGregorian(currentYear, currentMonth, 1);
    } catch (e) {
      firstDayG = DateTime.now();
    }
    final startOffset = _getWeekdayOffset(firstDayG.weekday);
    final totalGridCells = startOffset + totalDays;

    final monthEvents = ShiaData.events.where((e) => e.month == currentMonth).toList();
    final selectedDayEvents = ShiaData.events.where((e) => e.day == selectedDay && e.month == currentMonth).toList();

    return Directionality(
      textDirection: TextDirection.rtl,
      child: DraggableScrollableSheet(
        initialChildSize: 0.85,
        minChildSize: 0.6,
        maxChildSize: 0.95,
        expand: false,
        builder: (context, scrollController) {
          return Container(
            decoration: const BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
            ),
            child: Column(
              children: [
                Container(
                  width: 40,
                  height: 4,
                  margin: const EdgeInsets.symmetric(vertical: 12),
                  decoration: BoxDecoration(
                    color: Colors.grey[300],
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
                
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      IconButton(
                        icon: const Icon(Icons.arrow_back_ios, size: 20, color: Color(0xFF8A1525)),
                        onPressed: () => _changeMonth(-1),
                      ),
                      
                      Column(
                        children: [
                          Text(
                            hijriMonths[currentMonth - 1],
                            style: GoogleFonts.cairo(
                              fontSize: 18,
                              fontWeight: FontWeight.w900,
                              color: const Color(0xFF8A1525),
                            ),
                          ),
                          Text(
                            "$currentYear هـ",
                            style: GoogleFonts.cairo(
                              fontSize: 13,
                              fontWeight: FontWeight.bold,
                              color: const Color(0xFFC5A880),
                            ),
                          ),
                        ],
                      ),
                      
                      IconButton(
                        icon: const Icon(Icons.arrow_forward_ios, size: 20, color: Color(0xFF8A1525)),
                        onPressed: () => _changeMonth(1),
                      ),
                    ],
                  ),
                ),
                
                const Divider(height: 12, color: Color(0xFFF1F5F9)),

                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceAround,
                    children: const [
                      _WeekdayHeaderCell(title: "السبت"),
                      _WeekdayHeaderCell(title: "الأحد"),
                      _WeekdayHeaderCell(title: "الإثنين"),
                      _WeekdayHeaderCell(title: "الثلاثاء"),
                      _WeekdayHeaderCell(title: "الأربعاء"),
                      _WeekdayHeaderCell(title: "الخميس"),
                      _WeekdayHeaderCell(title: "الجمعة"),
                    ],
                  ),
                ),
                
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16),
                  child: GridView.builder(
                    shrinkWrap: true,
                    physics: const NeverScrollableScrollPhysics(),
                    gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                      crossAxisCount: 7,
                      mainAxisSpacing: 8,
                      crossAxisSpacing: 8,
                      childAspectRatio: 1.0,
                    ),
                    itemCount: totalGridCells,
                    itemBuilder: (context, index) {
                      if (index < startOffset) {
                        return const SizedBox();
                      }
                      
                      final dayNum = index - startOffset + 1;
                      
                      final isToday = dayNum == todayHijri.hDay &&
                                      currentMonth == todayHijri.hMonth &&
                                      currentYear == todayHijri.hYear;
                                      
                      final isSelected = dayNum == selectedDay;

                      final dayEvents = ShiaData.events.where((e) => e.day == dayNum && e.month == currentMonth).toList();
                      final hasEvents = dayEvents.isNotEmpty;
                      final hasMartyrdom = dayEvents.any((e) => e.isMartyrdom);

                      return GestureDetector(
                        onTap: () {
                          setState(() {
                            selectedDay = dayNum;
                          });
                        },
                        child: AnimatedContainer(
                          duration: const Duration(milliseconds: 200),
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            color: isToday
                                ? const Color(0xFF8A1525)
                                : isSelected
                                    ? const Color(0xFF8A1525).withValues(alpha: 0.15)
                                    : Colors.transparent,
                            border: Border.all(
                              color: isSelected
                                  ? const Color(0xFF8A1525)
                                  : isToday
                                      ? const Color(0xFF8A1525)
                                      : Colors.grey[200]!,
                              width: isSelected || isToday ? 2 : 1,
                            ),
                          ),
                          child: Column(
                            mainAxisAlignment: MainAxisAlignment.center,
                            children: [
                              Text(
                                dayNum.toString(),
                                style: GoogleFonts.cairo(
                                  fontSize: 14,
                                  fontWeight: FontWeight.bold,
                                  color: isToday
                                      ? Colors.white
                                      : const Color(0xFF1E293B),
                                ),
                              ),
                              if (hasEvents)
                                Container(
                                  width: 5,
                                  height: 5,
                                  margin: const EdgeInsets.only(top: 2),
                                  decoration: BoxDecoration(
                                    shape: BoxShape.circle,
                                    color: hasMartyrdom
                                        ? Colors.red
                                        : const Color(0xFFC5A880),
                                  ),
                                ),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
                ),
                
                const SizedBox(height: 8),
                const Divider(height: 12, color: Color(0xFFF1F5F9)),

                Expanded(
                  child: ListView(
                    controller: scrollController,
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    children: [
                      const SizedBox(height: 8),
                      Row(
                        children: [
                          const Icon(Icons.bookmark_outline, size: 16, color: Color(0xFF8A1525)),
                          const SizedBox(width: 6),
                          Text(
                            "أعمال ومناسبات اليوم المختار ($selectedDay ${hijriMonths[currentMonth - 1]}):",
                            style: GoogleFonts.cairo(
                              fontSize: 13,
                              fontWeight: FontWeight.bold,
                              color: const Color(0xFF8A1525),
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 6),
                      if (selectedDayEvents.isEmpty)
                        Container(
                          padding: const EdgeInsets.all(12),
                          decoration: BoxDecoration(
                            color: const Color(0xFFF8FAFC),
                            borderRadius: BorderRadius.circular(12),
                            border: Border.all(color: Colors.grey[300]!),
                          ),
                          child: Text(
                            "لا توجد مناسبات أو أعمال مأثورة مسجلة لهذا اليوم بعينه. يمكنك تصفح مناسبات الشهر بالأسفل.",
                            style: GoogleFonts.cairo(
                              fontSize: 11,
                              color: Colors.grey[500],
                            ),
                          ),
                        )
                      else
                        ...selectedDayEvents.map((event) => _buildCalendarEventCard(event)),
                      
                      const SizedBox(height: 16),
                      const Divider(height: 8, color: Color(0xFFF1F5F9)),
                      const SizedBox(height: 8),
                      
                      Row(
                        children: [
                          const Icon(Icons.event_note, size: 16, color: Color(0xFFC5A880)),
                          const SizedBox(width: 6),
                          Text(
                            "مناسبات شهر ${hijriMonths[currentMonth - 1]} بالكامل:",
                            style: GoogleFonts.cairo(
                              fontSize: 13,
                              fontWeight: FontWeight.bold,
                              color: const Color(0xFF1E293B),
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 6),
                      if (monthEvents.isEmpty)
                        Container(
                          padding: const EdgeInsets.all(12),
                          decoration: BoxDecoration(
                            color: const Color(0xFFF8FAFC),
                            borderRadius: BorderRadius.circular(12),
                          ),
                          child: Text(
                            "لا توجد مناسبات مسجلة لهذا الشهر في الأرشيف.",
                            style: GoogleFonts.cairo(
                              fontSize: 11,
                              color: Colors.grey[500],
                            ),
                          ),
                        )
                      else
                        ...monthEvents.map((event) => _buildCalendarEventCard(event, highlightSelected: event.day == selectedDay)),
                      
                      const SizedBox(height: 24),
                    ],
                  ),
                ),
              ],
            ),
          );
        },
      ),
    );
  }

  Widget _buildCalendarEventCard(HijriEvent event, {bool highlightSelected = false}) {
    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: highlightSelected
            ? (event.isMartyrdom ? const Color(0xFFFFF1F2) : const Color(0xFFFEF3C7))
            : (event.isMartyrdom ? const Color(0xFFFEF2F2) : const Color(0xFFFFFBEB)),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: highlightSelected
              ? (event.isMartyrdom ? Colors.red[400]! : const Color(0xFFC5A880))
              : (event.isMartyrdom 
                  ? Colors.red.withValues(alpha: 0.15) 
                  : const Color(0xFFC5A880).withValues(alpha: 0.15)),
          width: highlightSelected ? 2 : 1,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Row(
                children: [
                  Icon(
                    event.isMartyrdom ? Icons.brightness_1 : Icons.star,
                    color: event.isMartyrdom ? Colors.red : const Color(0xFFC5A880),
                    size: 12,
                  ),
                  const SizedBox(width: 6),
                  Text(
                    event.title,
                    style: GoogleFonts.cairo(
                      fontSize: 12.5,
                      fontWeight: FontWeight.bold,
                      color: event.isMartyrdom ? Colors.red[850] : const Color(0xFFC5A880),
                    ),
                  ),
                ],
              ),
              Text(
                "${event.day} / ${event.month}",
                style: GoogleFonts.cairo(
                  fontSize: 10.5,
                  fontWeight: FontWeight.bold,
                  color: const Color(0xFF475569),
                ),
              ),
            ],
          ),
          const SizedBox(height: 4),
          Text(
            event.description,
            style: GoogleFonts.cairo(
              fontSize: 11.5,
              color: const Color(0xFF0F172A).withValues(alpha: 0.75),
              height: 1.5,
            ),
          ),
          if (event.recommendedActs.isNotEmpty) ...[
            const Divider(height: 10, color: Color(0xFFF1F5F9)),
            Text(
              "الأعمال المستحبة المأثورة:",
              style: GoogleFonts.cairo(
                fontSize: 11.5,
                fontWeight: FontWeight.bold,
                color: const Color(0xFF0F172A),
              ),
            ),
            const SizedBox(height: 2),
            Text(
              event.recommendedActs,
              style: GoogleFonts.cairo(
                fontSize: 11,
                color: const Color(0xFF8A1525),
                height: 1.4,
              ),
            ),
          ],
        ],
      ),
    );
  }
}

class _WeekdayHeaderCell extends StatelessWidget {
  final String title;

  const _WeekdayHeaderCell({required this.title});

  @override
  Widget build(BuildContext context) {
    return Expanded(
      child: Center(
        child: Text(
          title,
          style: GoogleFonts.cairo(
            fontSize: 11.5,
            fontWeight: FontWeight.w800,
            color: const Color(0xFF64748B),
          ),
        ),
      ),
    );
  }
}
