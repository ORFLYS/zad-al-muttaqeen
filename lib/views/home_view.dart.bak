اللَّهُمَّ إِنِّي أَسْأَلُكَ بِرَحْمَتِكَ الَّتِي وَسِعَتْ كُلَّ شَيْءٍ، وَبِقُوَّتِكَ Lَّتِي قَهَرْتَ بِهَا كُلَّ شَيْءٍ، وَخَضَعَ لَهَا كُلُّ شَيْءٍ، وَذَلَّ لَهَا كُلُّ شَيْءٍ، وَبِجَبَرُوتِكَ الَّتِي غَلَبْتَ بِهَا كُلَّ شَيْءٍ، وَبِعِزَّتِكَ الَّتِي لا يَقُومُ لَهَا شَيْءٌ، وَبِعَظَمَتِكَ الَّتِي مَلأَتْ كُلَّ شَيْءٍ، وَبِسُلْطَانِكَ الَّذِي عَلا كُلَّ شَيْءٍ.

وَبِوَجْهِكَ البَاقِي بَعْدَ فَنَاءِ كُلِّ شَيْءٍ، وَبِأَسْمَائِكَ الَّتِي مَلأَتْ أَرْكَانَ كُلِّ شَيْءٍ، وَبِعِلْمِكَ الَّذِي أَحَاطَ بِكُلِّ شَيْءٍ، وَبِنُورِ وَجْهِكَ الَّذِي أَضَاءَ لَهُ كُلُّ شَيْءٍ.

يَا نُورُ يَا قُدُّوسُ، يَا أَوَّلَ الأوَّلِينَ وَيَا آخِرَ الآخِرِينَ. اللَّهُمَّ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تَهْتِكُ العِصَمَ، اللَّهُمَّ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تُنْزِلُ النِّقَمَ، اللَّهُمَّ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تُغَيِّرُ النِّعَمَ، اللَّهُمَّ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تَحْبِسُ الدُّعَاءَ..."""
    }
  ];

  @override
  void initState() {
    super.initState();
    _startTimer();
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  void _startTimer() {
    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      _sliderTick++;
      if (_sliderTick >= 5) {
        _sliderTick = 0;
        _slideNext();
      }
    });
  }

  void _slideNext() {
    if (!mounted) return;
    setState(() {
      _activeSliderIndex = (_activeSliderIndex + 1) % _sliderItems.length;
    });
  }

  /// تحديد الصلاة الشرعية النشطة زمنياً بدقة تامة لإبرازها باللون الذهبي
  String _getActivePrayerName() {
    final provider = Provider.of<AppProvider>(context, listen: false);
    final times = provider.prayerTimes;
    if (times == null) return "";

    final now = DateTime.now();

    final sobh = DateTime(now.year, now.month, now.day, times.fajr.hour, times.fajr.minute);
    final sunrise = DateTime(now.year, now.month, now.day, times.sunrise.hour, times.sunrise.minute);
    final dhuhr = DateTime(now.year, now.month, now.day, times.dhuhr.hour, times.dhuhr.minute);
    final sunset = DateTime(now.year, now.month, now.day, times.sunset.hour, times.sunset.minute);
    final maghrib = DateTime(now.year, now.month, now.day, times.maghrib.hour, times.maghrib.minute);
    final midnight = DateTime(now.year, now.month, now.day, times.midnight.hour, times.midnight.minute);

    if (now.isAfter(sobh) && now.isBefore(sunrise)) {
      return "صلاة الصبح";
    } else if (now.isAfter(sunrise) && now.isBefore(dhuhr)) {
      return "الشروق";
    } else if (now.isAfter(dhuhr) && now.isBefore(sunset)) {
      return "صلاة الظهر";
    } else if (now.isAfter(sunset) && now.isBefore(maghrib)) {
      return "الغروب";
    } else if (now.isAfter(maghrib) && now.isBefore(midnight)) {
      return "صلاة المغرب";
    } else {
      return "منتصف الليل";
    }
  }

  /// بناء حاوية الزجاج المصقول الفائقة النعومة والرقة (Ultra-Thin Frosted Glass)
  Widget _buildThinGlassCard({
    required Widget child,
    required EdgeInsets margin,
    required EdgeInsets padding,
    double borderRadius = 20,
    double opacity = 0.85,
  }) {
    return Container(
      margin: margin,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(borderRadius),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.15),
            blurRadius: 20,
            offset: const Offset(0, 8),
          )
        ],
      ),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(borderRadius),
        child: BackdropFilter(
          filter: ImageFilter.blur(sigmaX: 0, sigmaY: 0),
          child: Container(
            padding: padding,
            decoration: BoxDecoration(
              color: Colors.black.withValues(alpha: opacity),
              borderRadius: BorderRadius.circular(borderRadius),
              border: Border.all(
                color: Colors.white.withValues(alpha: 0.18),
                width: 1.0,
              ),
            ),
            child: child,
          ),
        ),
      ),
    );
  }

